{"identifier":{"url":"doc:\/\/WalletKit\/documentation\/WalletKit\/InitializeAWalletAndSendATransaction","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/WalletKit\/documentation\/WalletKit"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"This tutorial uses an Ethereum testnet endpoint. Replace the endpoint and"},{"type":"text","text":" "},{"type":"text","text":"recipient with values appropriate for your application, and present the"},{"text":" ","type":"text"},{"type":"text","text":"transfer details to the person before requesting a signature."}],"type":"paragraph"},{"text":"Create the Wallet","level":2,"type":"heading","anchor":"Create-the-Wallet"},{"inlineContent":[{"text":"Generate a recovery phrase, derive the first Ethereum BIP-44 account, and","type":"text"},{"text":" ","type":"text"},{"text":"create a signer for the selected chain. Store the recovery phrase using your","type":"text"},{"text":" ","type":"text"},{"text":"application’s secure backup flow before deriving accounts from it.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import Foundation","import WalletKit","","let chainId: UInt64 = 11_155_111 \/\/ Sepolia","","let mnemonic = Mnemonic.generate(wordCount: .words24)","let seed = mnemonic.toSeed()","","let derivationPath = try DerivationPath(","    .evm(EVMBlockchain(chainId: chainId)),","    accountIndex: 0,","    curve: .secp256k1",")","","let privateKey = try seed","    .masterKey(curve: .secp256k1)","    .derive(derivationPath)","    .privateKey()","    ","let signer = try EthereumPKeySigner(","    chainId: chainId,","    privateKey: privateKey,","    derivationPath: derivationPath",")","","let sender = try signer.address()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Never print or transmit "},{"type":"codeVoice","code":"mnemonic.phrase"},{"text":", ","type":"text"},{"type":"codeVoice","code":"seed"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"privateKey"},{"text":". An","type":"text"},{"text":" ","type":"text"},{"text":"application normally retains only the encrypted wallet material it needs to","type":"text"},{"text":" ","type":"text"},{"text":"restore the account later.","type":"text"}]},{"text":"Build, Sign, and Broadcast a Transfer","type":"heading","anchor":"Build-Sign-and-Broadcast-a-Transfer","level":2},{"type":"paragraph","inlineContent":[{"text":"Use a client for the same chain as the signer. The transaction builder retrieves","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the current nonce and fee information before preparing the unsigned transfer."}]},{"type":"codeListing","code":["import BigInt","","let client = EthereumRPCClient(","    endpoint: URL(string: \"https:\/\/your-sepolia-rpc.example\")!,","    chainId: chainId",")","","let recipient = try EthereumAddress(","    string: \"0x000000000000000000000000000000000000dEaD\"",")","","let transactionBuilder = EthereumTransactionBuilder(client: client)","","let unsignedTransaction = try await transactionBuilder.buildTransfer(","    sender: sender,","    recipient: recipient,","    amount: BigUInt(1_000_000_000_000_000), \/\/ 0.001 ETH in wei","    token: nil",")","","let signedTransaction = try await signer.sign(transaction: unsignedTransaction)","let transactionHash = try await client.broadcast(signedTransaction)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"broadcast(_:)"},{"text":" reports that the node accepted the transaction; it is not a","type":"text"},{"text":" ","type":"text"},{"text":"confirmation. Continue observing the transaction or refresh the account state","type":"text"},{"type":"text","text":" "},{"text":"until the required confirmation policy is met.","type":"text"}]}]}],"seeAlsoSections":[{"title":"Related Documentation","id